struct Point {
    private x: i32;
    private y: i32;
    private z: i32;

    public func new(var x: i32, var y: i32, var z: i32) var Self {
        return Point { x: x, y: y, z: z };
    }

    public func get_x(const self: Self) const i32 {
        return self.x;
    }

    public func set_x(var self: Self, const x: i32) var Self {
        self.x = x;
        return self;
    }
}

func main() const i32 {
    var x: i32 = 1;
    var y: i32 = 2;
    var z: i32 = 3;
    var p: Point = Point:new(x, y, z);
    return 0;
}

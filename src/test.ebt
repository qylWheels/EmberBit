struct Point {
    private x: Integer;
    private y: Integer;
    private z: Integer;

    public func new(var x: Integer, var y: Integer, var z: Integer) var Self {
        return Point { x: x, y: y, z: z };
    }

    public func get_x(const self: Self) const Integer {
        return self.x;
    }

    public func get_y(const self: Self) const Integer {
        return self.y;
    }

    public func get_z(const self: Self) const Integer {
        return self.z;
    }
}

func main() const Integer {
    var p1: Point = Point:new(1, 2, 3);
    var p2: Point = Point:new(2, 3, 5);

    return dist_square_of_two_points(p1, p2);
}

func dist_square_of_two_points(const p1: Point, const p2: Point) const Integer {
    const p1x: Integer = p1.get_x();
    const p1y: Integer = p1.get_y();
    const p1z: Integer = p1.get_z();
    const p2x: Integer = p2.get_x();
    const p2y: Integer = p2.get_y();
    const p2z: Integer = p2.get_z();

    return (p1x - p2x) * (p1x - p2x) + (p1y - p2y) * (p1y - p2y)
        + (p1z - p2z) * (p1z - p2z);
}

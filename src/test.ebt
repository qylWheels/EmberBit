struct Point {
    x: i32;
    y: i32;
    distsquare: (const i32, const i32) i32;
}

func main() i32 {
    var p: Point = Point { x: 1, y: 2, distsquare: distsquare };
    p.x = 2;
    p.y = 3;
    return p.distsquare(p.x, p.y);
}

func distsquare(const x: i32, const y: i32) i32 {
    return x * x + y * y;
}

func add(const x: i32, var y: i32) i32 {
    return x + y;
}

func complicated(const x: i32, const y: i32) i32 {
    return (x - y) * x + y / x;
}

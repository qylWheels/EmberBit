struct Point {
    public x: i32;
    public y: i32;

    public func distsquare(const self: Self) i32 {
        const x: i32 = self.x;
        const y: i32 = self.y;
        return x * x + y * y;
    }

    private func thisisprivatemethod(var p: Point) Point {
        return p;
    }
}

func main() i32 {
    var p: Point = Point { x: 1, y: 2 };
    p.x = 2;
    p.y = 3;
    return p.distsquare(p);
}

struct Point {
    private x: Integer;
    private y: Integer;
    private z: Integer;

    public func new(var x: Integer, var y: Integer, var z: Integer) var Self {
        return Point { x: x, y: y, z: z };
    }

    public func get_x(const self: Self) const Integer {
        return self.x;
    }

    public func get_y(const self: Self) const Integer {
        return self.y;
    }

    public func get_z(const self: Self) const Integer {
        return self.z;
    }
}

struct Line {
    private start: Point;
    private end: Point;

    public func new(var start: Point, var end: Point) var Self {
        return Line { start: start, end: end };
    }

    public func set_start(var self: Self, var new_start: Point) var Self {
        self.start = new_start;
        return self;
    }

    public func length_2(const self: Self) const Integer {
        const start_x = self.start->get_x();
        const start_y = self.start->get_y();
        const start_z = self.start->get_z();
        const end_x = self.end->get_x();
        const end_y = self.end->get_y();
        const end_z = self.end->get_z();

        return (start_x - end_x) * (start_x - end_x) + (start_y - end_y) * (start_y - end_y)
            + (start_z - end_z) * (start_z - end_z);
    }
}

func fibonacci(const n: Integer) const Integer {
    var result = 0;
    if n <= 2 {
        result = 1;
    } else {
        result = fibonacci(n - 2) + fibonacci(n - 1);
    }
    return result;
}

func main() const Integer {
    var p1 = Point::new(1, 2, 3);
    var p2 = Point::new(2, 3, 5);

    var line = Line::new(p1, p2);
    line->set_start(Point::new(6, 6, 6));

    return fibonacci(25);
}

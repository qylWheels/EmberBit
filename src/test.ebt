struct Point {
    x: i32;
    y: i32;
}

struct List {
    x: i32;
    next: List;
}

func main() i32 {
    const p: Point = Point { x: 100, y: 200 };
    return complicated(p.x, p.y);
}

func add(x: i32, y: i32) i32 {
    return x + y;
}

func complicated(x: i32, y: i32) i32 {
    return (x - y) * x + y / x;
}

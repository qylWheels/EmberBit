struct Point {
    public x: i32;
    public y: i32;
    public z: i32;

    public func setx(var self: Self, const x: i32) Self {
        self.x = x;
        return self;
    }

    public func distsquare(const self: Self) i32 {
        const x: i32 = self.x;
        const y: i32 = self.y;
        const z: i32 = self.z;
        return x * x + y * y + z * z;
    }

    private func thisisprivatemethod(var p: Point) Point {
        return p;
    }
}

func main() i32 {
    var p: Point = Point { x: 1, y: 2, z: 3 };
    p.setx(2).setx(3).setx(4);
    return p.distsquare();
}

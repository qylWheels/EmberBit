struct Point {
    public x: i32;
    public y: i32;

    public distsquare: (const Point) i32;

    public func distsquare2(const p: Point) i32 {
        const x: i32 = p.x;
        const y: i32 = p.y;
        return x * x + y * y;
    }
}

func main() i32 {
    var p: Point = Point { x: 1, y: 2, distsquare: distsquare };
    p.x = 2;
    p.y = 3;
    return p.distsquare(p);
}

func distsquare(const p: Point) i32 {
    const x: i32 = p.x;
    const y: i32 = p.y;
    return x * x + y * y;
}

func add(const x: i32, var y: i32) i32 {
    return x + y;
}

func complicated(const x: i32, const y: i32) i32 {
    return (x - y) * x + y / x;
}

struct Point {
    x: i32;
    y: i32;
}

struct List {
    x: i32;
    next: List;
}

func main() i32 {
    var p: Point = Point { x: 1, y: 2 };
    p.x = 514;
    p.y = 114000;
    return add(p.x, p.y);
}

func add(x: i32, y: i32) i32 {
    return x + y;
}

func complicated(x: i32, y: i32) i32 {
    return (x - y) * x + y / x;
}
